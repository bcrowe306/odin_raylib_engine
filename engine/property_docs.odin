package engine

// ============================================================================
// Property docs: one line of help for every reflected (gui-tagged) property,
// shown in the Inspector's tooltips and help pane. Looked up as
// "Struct.field" (the struct that declares the field), then by the field name
// alone for the shared ones (tint, debugColor, joint springs...).
// test_property_docs fails when a node type's property has none.
// ============================================================================

Property_Doc_Entry :: struct {
	key, doc: string,
}

// Property_Doc: the help line for a property ("" when there is none).
Property_Doc :: proc(p: Node_Property) -> string {
	@(static) table: map[string]string
	if table == nil {
		table = make(map[string]string, len(PROPERTY_DOCS) + len(PROPERTY_DOCS_SHARED))
		for e in PROPERTY_DOCS_SHARED do table[e.key] = e.doc
		for e in PROPERTY_DOCS do table[e.key] = e.doc
	}
	field := p.name
	for i := len(field) - 1; i >= 0; i -= 1 {
		if field[i] == '.' {field = field[i + 1:]; break}
	}
	if p.owner != "" {
		buf: [128]u8
		n := copy(buf[:], p.owner)
		if n < len(buf) {buf[n] = '.'; n += 1}
		n += copy(buf[n:], field)
		if d, ok := table[string(buf[:n])]; ok do return d
	}
	return table[field] or_else ""
}

// Shared field names (any struct).
@(rodata)
PROPERTY_DOCS_SHARED := [?]Property_Doc_Entry {
	{"tint", "Multiplies the texture's colours (white = unchanged; alpha fades it)."},
	{"debugColor", "Colour of the collider outline drawn with Show Bounds & Colliders (and the game's debug draw)."},
	{"collideConnected", "Let the two connected bodies collide with each other."},
	{"localAnchorA", "Anchor on body A, relative to its origin (px)."},
	{"localAnchorB", "Anchor on body B, relative to its origin (px)."},
	{"referenceAngle", "Body B's angle relative to body A that counts as zero (degrees)."},
	{"enableSpring", "Make the joint springy instead of rigid."},
	{"hertz", "Spring stiffness as an oscillation frequency (Hz); 0 = no spring."},
	{"dampingRatio", "Spring damping: 0 bounces forever, 1 settles without overshoot."},
	{"enableLimit", "Clamp the joint's travel to the lower / upper limits."},
	{"enableMotor", "Drive the joint at Motor Speed, up to the maximum force / torque."},
	{"categoryLayers", "Collision layers this object is on (names in Project Settings > Physics)."},
	{"maskLayers", "Collision layers this object collides with."},
	{"label", "Caption shown next to the control."},
	{"labelWidth", "Width reserved for the label (px); 0 = none."},
	{"selectedIndex", "Index of the selected item (-1 = none)."},
	{"defaultIndex", "Index restored by reset."},
	{"itemHeight", "Height of each row (px)."},
	{"minValue", "Lowest value."},
	{"maxValue", "Highest value."},
	{"defaultValue", "Value restored by reset (double-click)."},
	{"value", "Current value."},
	{"orientation", "Horizontal or vertical."},
	{"align", "Horizontal text alignment."},
	{"lineColor", "Colour of the line."},
	{"textColor", "Colour of the text."},
	{"borderColor", "Colour of the border."},
	{"backgroundColor", "Fill colour of the background."},
	{"drawBackground", "Fill the background."},
	{"fontSize", "Text size (px)."},
	{"text", "Text shown."},
	{"icon", "Icon shown (Font Awesome)."},
	{"iconSize", "Icon size (px)."},
	{"color", "Colour."},
	{"spacing", "Gap between items (px)."},
	{"headerHeight", "Height of the header (px)."},
}

