# Spawning: Scene.instantiate is typed per component (its root's type)
# and queue_free completes on nodes.
wait 5
wait-until file:.rayzr/definitions/project_types.lua contains fun(component: "components/AsteroidLarge.component.json", parent?: Node, x?: number|Vec2, y?: number): DynamicBodyNode timeout=600
dblclick @asset:scripts/player_ship.lua
wait-until code.lsp == ready timeout=600
key ctrl+g
type 17
key enter
key enter
key up
type local rock = Scene.instantiate("components/AsteroidLarge.component.json", nil, self.node.position)
key enter
type rock:apply_imp
wait-until code.completion contains apply_impulse timeout=600
key esc
key end
key enter
type rock:queue_f
wait-until code.completion contains queue_free timeout=600
