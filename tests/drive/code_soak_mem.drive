# Memory soak for the Code tab: 40 rounds of typing, undo, folding, soft
# wrap, find, peek-free navigation and menus (run with
# EDITOR_DEFINES=-define:ORE_MEM_TRACK=true: live memory must not climb).
wait 5
dblclick @asset:scripts/player_ship.lua
wait 30
key ctrl+g
type 30
key enter
key end
type \s-- soak
key cmd+z
key ctrl+g
type 24
key enter
key cmd+alt+lbracket
wait 2
key cmd+alt+rbracket
key alt+z
wait 2
key alt+z
key cmd+f
type self
key esc
key ctrl+shift+right
key ctrl+shift+right
key ctrl+shift+left
key cmd+c
key cmd+shift+v
key esc
rclick @code.caret
key esc
wait 5
key ctrl+g
type 30
key enter
key end
