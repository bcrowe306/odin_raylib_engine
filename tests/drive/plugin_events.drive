# Plugin events (plugin_events.odin): project_opened, selection_changed,
# scene_saved, asset_imported, after_export, and before_play refusing a Play
# (the next one goes ahead).
# drive: serial (exports: reads bin/runners)
exec mkdir -p $PROJECT/plugins
exec cp -R tests/drive/fixtures/plugins/events_zz $PROJECT/plugins/
wait 5
click @toolbar.settings
click @settings.tab:plugins
click @plugins.rescan
click @plugins.trust.toggle
wait 3
click @settings.cancel
wait 2
expect plugin:events_zz.log contains opened=Asteroids
click @hier:PlayerShip
wait 2
expect plugin:events_zz.log contains selected=1 first=PlayerShip
dblclick @insp.name
key ctrl+a
type EventShip
key enter
key cmd+s
wait 2
expect plugin:events_zz.log contains saved=scenes/main.scene.json
# Play: refused once, then plays.
click @toolbar.play
wait 3
expect log contains Play cancelled: fix the level first
expect plugin:events_zz.log contains before_play=scenes/main.scene.json
expect game == stopped
game-args --frames 20 --dump-scene $SHOTS/played.json
click @toolbar.play
wait-until game == running timeout=600
wait-until game == stopped timeout=900
drop-files @asset.search tests/drive/fixtures/import/Pack/gem.png
wait 3
expect plugin:events_zz.log contains imported=
click @toolbar.settings
click @settings.page:Export
click @settings.export-now
wait 10
expect plugin:events_zz.log contains exported=
