# Screenshots for the UI nodes' pages, part 1 (docs/nodes/*.md, #45):
# Screen Layer, Dialogue Box, UI Container, Label, Button, Slider, Checkbox,
# Progress Bar, Text Input, Dropdown, Radio Group, Toggle Switch, Knob.
#   scripts/docs/screenshots.sh docs_nodes_ui1
wait 5

# --- Screen Layer: a score label anchored top right ---
click @asset.new-scene
wait 5
key shift+home
click @hier.add
type screen layer
click @addnode.create
wait 3
expect node:ScreenLayer.type == ScreenLayerNode
hover @insp.prop:anchor
click @insp.prop:anchor
wait 2
click @pick:TopRight
wait 2
click @hier.add
type ui label
click @addnode.create
wait 3
expect node:UILabel.parent == ScreenLayer
click @insp.prop:text
key cmd+a
type Score: 1200
key enter
dblclick @insp.prop:fontSize
key ctrl+a
type 40
key enter
dblclick @insp.position.x
key ctrl+a
type -260
key enter
dblclick @insp.position.y
key ctrl+a
type 24
key enter
click @hier:ScreenLayer
wait 2
key shift+home
wait 3
# The Anchor picker open: the nine points of the screen.
click @insp.prop:anchor
wait 2
annotate @node:UILabel A label under the layer: (-260, 24) from the frame's top-right corner
annotate @window:inspector Anchor: the point of the screen the layer sits at
screenshot node_ScreenLayerNode
key escape
wait 2

# --- Dialogue Box: lines shown from the Lua console in Simulate ---
click @asset.new-scene
wait 5
key shift+home
click @hier.add
type dialogue box
click @addnode.create
wait 3
expect node:DialogueBox.type == DialogueNode
dblclick @insp.position.x
key ctrl+a
type 190
key enter
dblclick @insp.position.y
key ctrl+a
type 520
key enter
click @menu:Game
click @menu:Game/Simulate in Editor
wait 10
click @bottom:console
click @console.lua
type Scene.find_node("DialogueBox"):dialogue_show({ { speaker = "Guard", text = "Halt! Nobody passes the gate after dark." }, { speaker = "Guard", text = "Come back in the morning." } })
key enter
wait 120
key shift+home
wait 3
annotate @node:DialogueBox The box: speaker, the typed-out line, the "more" marker
annotate @window:inspector Colours, padding, typing speed, advance action, mode
screenshot node_DialogueNode
click @menu:Game
click @menu:Game/Simulate in Editor
wait 5

# --- UI Container: a vertical options panel (laid out in Simulate) ---
click @asset.new-scene
wait 5
key shift+home
click @hier.add
type ui container
click @addnode.create
wait 3
expect node:UIContainer.type == UIContainerNode
click @insp.prop:title
key cmd+a
type Options
key enter
click @hier.add
type ui label
click @addnode.create
wait 3
expect node:UILabel.parent == UIContainer
click @insp.prop:text
key cmd+a
type Audio
key enter
click @hier:UIContainer
click @hier.add
type ui slider
click @addnode.create
wait 3
click @hier:UIContainer
click @hier.add
type ui checkbox
click @addnode.create
wait 3
click @hier:UIContainer
click @hier.add
type ui button
click @addnode.create
wait 3
expect node:UIButton.parent == UIContainer
click @hier:UIContainer
click @menu:Game
click @menu:Game/Simulate in Editor
wait 10
click @hier:UIContainer
key shift+f
wait 3
annotate @node:UIContainer The panel: header, then its UI children in a column
annotate @window:inspector Direction, alignment, spacing, padding, colours
screenshot node_UIContainerNode
click @menu:Game
click @menu:Game/Simulate in Editor
wait 5

# --- UI Label ---
click @asset.new-scene
wait 5
key shift+home
click @hier.add
type ui label
click @addnode.create
wait 3
expect node:UILabel.type == UILabelNode
click @insp.prop:text
key cmd+a
type Level 3 - The Caves
key enter
click @insp.prop:drawBackground
expect node:UILabel.prop.drawBackground == true
key shift+f
wait 3
annotate @node:UILabel The label (Draw Background on)
annotate @window:inspector Text, size, colour, alignment, background
screenshot node_UILabelNode

