# Node-reference properties: a node dropped into the script's properties
# table adds `name = { type = "node" }`, set to that node once the script is
# saved; the Inspector's picker points it elsewhere; saved as a path.
wait 5
click @hier:PatrolDroneAlpha
click @insp.script-attach
click @pick:scripts/orbiting_drone.lua
click @insp.script-edit
wait 5
click @code.area
key ctrl+g
type 9
key enter
wait 2
drag @hier:MainCamera @code.caret
expect code.text contains     main_camera = { type = "node" }, -- MainCamera\n
key ctrl+s
wait 10
click @hier:PatrolDroneAlpha
expect node:PatrolDroneAlpha.script.main_camera == ../MainCamera
scroll @insp.position.x -80
wait 3
expect item:insp.script:main_camera == visible
screenshot picker
click @insp.script:main_camera
click @pick:PlayerShip
expect node:PatrolDroneAlpha.script.main_camera == ../PlayerShip
key ctrl+alt+s
wait 2
expect file:scenes/main.scene.json contains "main_camera": "../PlayerShip"
