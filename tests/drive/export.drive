# Export a portable .rayzr package and run the game from it.
# drive: serial (touches bin/runners or other shared files; runs after the parallel drives)
wait 5
click @hier:PlayerShip
dblclick @insp.name
key ctrl+a
type ExportedShip
key enter
click @toolbar.export
wait 10
expect log contains Exported portable .rayzr archive
expect modified == false
screenshot exported
exec bin/rayzr --project $PROJECT.rayzr --frames 20 --dump-scene $SHOTS/rayzr_scene.json
expect abs-file:$SHOTS/rayzr_scene.json contains "ExportedShip"
expect abs-file:$SHOTS/rayzr_scene.json contains "textures/Spaceship_1.png"
