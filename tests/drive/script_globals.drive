# Global scripts: right-click > Make Global (globe in Assets, saved in
# project.json, listed in Project Settings > Globals); the global completes
# in other scripts; Simulate runs its ready and update.
wait 5
exec cp tests/drive/fixtures/drive_global_zz.lua $PROJECT/scripts/drive_global_zz.lua
wait-until item:asset:scripts/drive_global_zz.lua == visible timeout=300
expect item:asset.global:scripts/drive_global_zz.lua == missing
rclick @asset:scripts/drive_global_zz.lua
click @ctx:make-global
wait 2
expect item:asset.global:scripts/drive_global_zz.lua == visible
expect file:project.json contains {"name": "DriveGlobalZz", "script": "scripts/drive_global_zz.lua"}
screenshot asset_globe
wait-until file:.rayzr/definitions/project_types.lua contains DriveGlobalZz = require("scripts/drive_global_zz") timeout=600

# Project Settings lists it.
click @toolbar.settings
click @settings.page:Globals
expect item:settings.global-name:0 == visible
expect item:settings.global-problem:0 == missing
screenshot settings_globals
click @settings.cancel

# Completes in another script.
dblclick @asset:scripts/player_ship.lua
wait-until code.lsp == ready timeout=600
key ctrl+g
type 17
key enter
key enter
key up
type DriveGlobalZz:add_p
wait-until code.completion contains add_points timeout=600
key esc
type oints(5)
key ctrl+s
wait 3
screenshot completion

# Simulate (the Viewport shown: it runs the frames): ready, then update.
key cmd+1
wait 1
expect item:viewport == visible
click @menu:Game
click @menu:Game/Simulate in Editor
wait 20
expect log contains drive global ready
expect log contains drive global updating
click @menu:Game
click @menu:Game/Simulate in Editor
wait 2

# Remove Global: the globe goes.
rclick @asset:scripts/drive_global_zz.lua
click @ctx:remove-global
wait 2
expect item:asset.global:scripts/drive_global_zz.lua == missing
expect file:project.json !contains DriveGlobalZz
