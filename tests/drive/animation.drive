# Animation timeline (bottom panel): frames from dropped textures, scrubbing,
# property tracks with keyframes, preview playback and restore, save.
wait 5
# The bottom panel starts 100 px tall: the Animation workspace gives its
# tools room.
click @menu:View
click @menu:View/Workspaces
click @menu:Workspaces/Animation
wait 3
click @hier:PlayerShip
key ctrl+a
type animation player
key enter
expect node:AnimationPlayer.type == AnimationPlayerNode
click @bottom:animation
click @anim.new
expect anim == anim_1:1/1:0
drag @asset:textures/Asteroid_1.png @anim.frame-drop
drag @asset:textures/Asteroid_2.png @anim.frame-drop
drag @asset:textures/Asteroid_3.png @anim.frame-drop
expect anim == anim_1:1/3:0
click @anim.frame:3
expect anim == anim_1:3/3:0
screenshot frames

# A rotation track keyed at frame 1 and frame 3.
click @anim.frame:1
click @anim.add-track
click @anim.track-prop:rotation
expect anim == anim_1:1/3:1
click @anim.frame:3
dblclick @insp.rotation
key ctrl+a
type 90
key enter
click @anim.key:rotation
expect item:anim.keyframe:rotation:3 == visible
screenshot keyframes
# Scrubbing interpolates; Stop restores the pre-preview value.
click @anim.frame:2
expect node:AnimationPlayer.rotation == 45.0
click @anim.stop
expect node:AnimationPlayer.rotation == 90.0
click @anim.play
wait 20
click @anim.stop
key ctrl+s
expect file:scenes/main.scene.json contains "tracks": [{"target": ".", "property": "rotation", "units": "seconds", "keys": [{"t": 0}, {"t": 0.1667, "v": [90, 0, 0, 0]}]}]
expect file:scenes/main.scene.json contains textures/Asteroid_3.png

# Easing on a key: out_quad from frame 1 to 3 puts frame 2 at 75%.
rclick @anim.keyframe:rotation:1
hover @anim.key-easing
wait 3
click @anim.ease:out_quad
click @anim.frame:2
expect node:AnimationPlayer.rotation == 67.5
screenshot key_easing
click @anim.stop
key ctrl+s
expect file:scenes/main.scene.json contains "keys": [{"t": 0, "ease": "out_quad"}, {"t": 0.1667, "v": [90, 0, 0, 0]}]

# A method track: a key calls a script method when playback reaches it.
click @anim.add-track
click @anim.track-node:AnimationPlayer
click @anim.track-methods
expect item:anim.key:@call == visible
click @anim.frame:2
click @anim.key:@call
expect item:anim.keyframe:@call:2 == visible
rclick @anim.keyframe:@call:2
click @anim.event-method
key ctrl+a
type on_footstep
screenshot method_track
click @anim.frame:1
click @toolbar.save
expect file:scenes/main.scene.json contains "property": "@call", "kind": "method", "units": "seconds", "keys": [{"t": 0.0833, "text": "on_footstep"}]

# Frame duration: edit duration of selected frame
click @anim.frame:2
click @anim.frame-duration
key ctrl+a
type 0.5
key enter

# Ad-hoc empty frame: insert empty frame via context menu
rclick @anim.frame:2
click @anim.ctx-insert-empty
expect anim == anim_1:2/4:2

# Shortcut tracks: Add particles and enable tracks
click @anim.add-track
click @anim.track-node:AnimationPlayer
click @anim.track-particles
expect item:anim.key:@particles == visible

click @anim.add-track
click @anim.track-node:AnimationPlayer
click @anim.track-enable
expect item:anim.key:@enable == visible
screenshot shortcut_tracks

click @toolbar.save
expect file:scenes/main.scene.json contains "kind": "particles"
expect file:scenes/main.scene.json contains "kind": "enable"

