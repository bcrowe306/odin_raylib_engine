# Live script values in the running game: the Game tab lists a node's
# exported script properties (script.<name>) and edits them in the game.
wait 5
click @menu:View
click @menu:View/Workspaces
click @menu:Workspaces/Animation
wait 3
key escape
click @hier:PatrolDroneAlpha
click @insp.script-attach
click @pick:scripts/orbiting_drone.lua
click @toolbar.play
wait-until game == running timeout=600
wait-until remote-connected == true timeout=600
click @bottom:game
wait-until remote-nodes >= 5 timeout=300
click @remote.node:PatrolDroneAlpha
wait-until remote-prop:script.orbit_radius contains 130 timeout=300
screenshot script_props
click @remote.prop:script.orbit_radius
key cmd+a
type 200
key enter
wait-until remote-prop:script.orbit_radius contains 200 timeout=300
click @toolbar.stop
wait-until game == stopped timeout=300
