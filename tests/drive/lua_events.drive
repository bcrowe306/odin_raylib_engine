# Event names complete: per node class in connect (a timer: "timeout"),
# the project's custom events (what scripts emit) in connect / emit, and a
# script's on_<event> methods (its node's events + custom ones).
wait 5
wait-until file:.rayzr/definitions/project_types.lua contains ---@alias ProjectEvent timeout=600
expect file:.rayzr/definitions/project_types.lua contains ---| "jumped"
expect file:.rayzr/definitions/project_types.lua contains ---@field on_jumped? fun(self: PlayerShip, value: any) custom event (emit)
expect file:.rayzr/definitions/engine_api.lua contains function TimerNode:connect(event, handler) end
dblclick @asset:scripts/player_ship.lua
wait-until code.lsp == ready timeout=600
key ctrl+g
type 17
key enter
key enter
key up
type ---@type TimerNode
key enter
type local timer
key enter
type timer:connect("t
wait-until code.completion contains timeout timeout=600
screenshot timer_events
key esc
key end
key enter
type self.node:emit("j
wait-until code.completion contains jumped timeout=600
key esc
key ctrl+g
type 86
key enter
key end
key enter
type function PlayerShip:on_
wait-until code.completion contains on_entered_tree timeout=600
expect code.completion contains on_jumped
screenshot on_methods
