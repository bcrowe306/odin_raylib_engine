# Tile map painting: add a TileMap - the bottom panel's Tile Map tab opens
# (settings row, tools, the tileset's tiles); pick a tileset and a tile,
# paint and erase in the viewport, flood fill, undo, save.
wait 5
# The bottom panel starts 100 px tall: the Animation workspace gives its
# tools room.
click @menu:View
click @menu:View/Workspaces
click @menu:Workspaces/Animation
wait 3
key escape
key ctrl+a
type tile map
key enter
expect selected == TileMap
expect node:TileMap.tiles == 0
wait 2
expect bottom-tab == TileMap
expect item:insp.tile.open == visible
screenshot empty_tab
click @tile.tileset
click @pick:textures/Asteroid_1.png
wait 2
click @tile.palette:6
expect item:tile.paint == visible
expect item:tile.zoom == visible
screenshot palette
click @tile.zoom-in
click @tile.grid
wait 1
screenshot palette_zoomed_grid
# Paint a stroke (one undo step).
drag @world:660,380 @world:820,380
expect node:TileMap.tiles >= 5
screenshot painted
key ctrl+z
expect node:TileMap.tiles == 0
key ctrl+y
expect node:TileMap.tiles >= 5
# Shrinking the map keeps the tiles; growing it back shows them.
dblclick @tile.map-w
key cmd+a
type 2
key enter
expect node:TileMap.tiles >= 5
screenshot shrunk_map_keeps_tiles
wait 3
dblclick @tile.map-w
key cmd+a
type 20
key enter
expect node:TileMap.tiles >= 5
expect selected == TileMap
# Painting outside the map (left of it).
drag @world:520,300 @world:600,300
expect node:TileMap.tiles >= 7
screenshot painted_outside
key ctrl+z
# Flood fill the rest of the map.
click @tile.fill
click @world:700,400
expect node:TileMap.tiles == 240
screenshot filled
# Erase with the right button... and with the eraser tool.
click @tile.erase
drag @world:660,380 @world:820,380
expect node:TileMap.tiles <= 235
click @tile.erase
key ctrl+s
expect file:scenes/main.scene.json contains "type": "TileMapNode"
expect file:scenes/main.scene.json contains "tileset": "textures/Asteroid_1.png"

# A big map draws from cached chunks (tile_cache.odin); edits refresh them.
dblclick @tile.map-w
key cmd+a
type 80
key enter
dblclick @tile.map-h
key cmd+a
type 80
key enter
click @toolbar.zoom
click @pick:25%
wait 2
click @tile.fill
click @world:1500,600
expect node:TileMap.tiles >= 6300
# Zoomed out: the whole map in view (enough tiles to use the chunk cache).
key cmd+minus
key cmd+minus
key cmd+minus
key cmd+minus
wait 2
expect tile-chunks >= 4
screenshot big_map_cached
click @tile.erase
drag @world:700,1200 @world:2000,1200
expect node:TileMap.tiles <= 6360
wait 2
screenshot big_map_erased

# #220: Fit Selection frames the whole map, not a tiny handle (which
# zoomed to 1000%).
click @hier:TileMap
key shift+f
wait 3
expect zoom <= 0.5
screenshot fit_map
