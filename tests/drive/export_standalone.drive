# Standalone export with a prebuilt runner (no compiler at export time):
# a project icon, the executable name, Save and Export, then the exported
# macOS app (bundle, Info.plist, icon, bundled Lua library, signature)
# runs and finds its game in Resources.
exec scripts/build_runners.sh --if-missing
# Stand-in Linux / Windows runners (the macOS one copied) to exercise their
# packaging here; removed at the end.
exec mkdir -p bin/runners/linux bin/runners/windows
exec cp bin/runners/macos/runner bin/runners/linux/runner
exec cp bin/runners/macos/runner bin/runners/windows/runner.exe
wait 5
click @toolbar.settings
click @settings.page:General
click @settings.icon
click @pick:textures/Spaceship_1.png
click @settings.page:Export
click @settings.export-name
key ctrl+a
type SpaceGame
click @settings.target:linux
click @settings.target:windows
expect item:settings.bundle-id == visible
screenshot export_settings
click @settings.export-now
wait 10
expect log contains Exported macos (macos):
expect log contains Signed SpaceGame.app (ad-hoc)
expect log contains Standalone game ready
expect log contains (3 preset(s))
expect log contains Exported linux (linux):
expect log contains Exported windows (windows):
expect log contains written when exporting on Windows
expect log !contains building it once
expect file:project.json contains "icon": "textures/Spaceship_1.png"
exec test -s $PROJECT_standalone/macos/SpaceGame.app/Contents/Resources/game.ore
exec test -s $PROJECT_standalone/macos/SpaceGame.app/Contents/Resources/AppIcon.icns
exec test -s $PROJECT_standalone/macos/SpaceGame.app/Contents/Resources/fonts/OpenSans-Regular.ttf
exec test -s $PROJECT_standalone/macos/SpaceGame.app/Contents/Frameworks/liblua.dylib
exec plutil -lint $PROJECT_standalone/macos/SpaceGame.app/Contents/Info.plist
expect abs-file:$PROJECT_standalone/macos/SpaceGame.app/Contents/Info.plist contains <string>SpaceGame</string>
expect abs-file:$PROJECT_standalone/macos/SpaceGame.app/Contents/Info.plist contains com.ore.spacegame
exec codesign --verify --deep --strict $PROJECT_standalone/macos/SpaceGame.app
exec $PROJECT_standalone/macos/SpaceGame.app/Contents/MacOS/SpaceGame --frames 20 --dump-scene $SHOTS/standalone_scene.json
expect abs-file:$SHOTS/standalone_scene.json contains "PlayerShip"

# Linux AppDir and Windows folder.
exec test -x $PROJECT_standalone/linux/SpaceGame.AppDir/AppRun
exec test -x $PROJECT_standalone/linux/SpaceGame.AppDir/usr/bin/SpaceGame
exec test -s $PROJECT_standalone/linux/SpaceGame.AppDir/usr/bin/game.ore
exec test -s $PROJECT_standalone/linux/SpaceGame.AppDir/SpaceGame.png
expect abs-file:$PROJECT_standalone/linux/SpaceGame.AppDir/SpaceGame.desktop contains Exec=SpaceGame
exec test -s $PROJECT_standalone/windows/SpaceGame.exe
exec test -s $PROJECT_standalone/windows/game.ore
exec rm -rf bin/runners/linux bin/runners/windows
