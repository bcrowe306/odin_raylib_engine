# #175: a Screen Layer (a HUD) - in Add Node, anchored top-right, a label
# under it; the editor draws it over the camera frame; saved with its anchor.
wait 5
click @asset.new-scene
wait 5
click @hier.add
wait 3
click @addnode.search
type screen layer
wait 2
expect item:addnode:Screen Layer == visible
click @addnode.create
wait 5
expect node:ScreenLayer.type == ScreenLayerNode
hover @insp.prop:anchor
click @insp.prop:anchor
wait 2
click @pick:TopRight
wait 2
expect node:ScreenLayer.prop.anchor == TopRight
click @hier.add
wait 3
click @addnode.search
type ui label
wait 2
click @addnode.create
wait 5
expect node:UILabel.parent == ScreenLayer
# The camera frame is (0, 0) - (1280, 720): the layer sits at its top-right.
expect node:ScreenLayer.position == 0.0,0.0
expect node:ScreenLayer.global == 1280.0,0.0
key home
wait 5
screenshot hud_over_camera_frame
click @toolbar.save
expect file:scenes/new_scene.scene.json contains "type": "ScreenLayerNode"
expect file:scenes/new_scene.scene.json contains "anchor": "TopRight"
