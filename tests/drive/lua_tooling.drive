# Lua tooling in the project: the editor writes the engine API definitions
# to .ore/definitions and a .luarc.json pointing at them (for the built-in
# editor and any LuaLS editor such as VS Code).
wait 5
expect file:.luarc.json contains "workspace.library": [".ore/definitions"]
expect file:.luarc.json contains "Lua 5.4"
expect file:.ore/definitions/engine_api.lua contains ---@class CameraModule
expect file:.ore/definitions/engine_api.lua contains function CharacterMoverNode:character_move_and_slide
