# --- Icon ---
click @asset.new-scene
click @hier.add
type ui icon
click @addnode.create
expect node:UIIcon.type == UIIconNode
click @insp.prop:icon
click @pick:Bolt
expect node:UIIcon.prop.icon == Bolt
key shift+f
wait 5
annotate @node:UIIcon A Bolt icon
annotate @window:inspector Icon, Icon Size, Color, Align
move 700,88
wait 20
screenshot node_UIIconNode

# --- Toolbar ---
click @asset.new-scene
click @hier.add
type ui toolbar
click @addnode.create
expect node:UIToolbar.type == UIToolbarNode
key shift+f
wait 5
annotate @node:UIToolbar The toolbar's bar (its buttons come from code)
annotate @window:inspector Button Size, Spacing, Active Toggle Id
move 700,88
wait 20
screenshot node_UIToolbarNode

# --- Tab Container with two labels ---
click @asset.new-scene
click @hier.add
type ui tab container
click @addnode.create
expect node:UITabContainer.type == UITabContainerNode
click @hier:UITabContainer
click @hier.add
type ui label
click @addnode.create
expect node:UILabel.parent == UITabContainer
click @hier:UITabContainer
click @hier.add
type ui button
click @addnode.create
expect node:UIButton.parent == UITabContainer
click @hier:UITabContainer
key shift+f
# The container lays its children out as it updates: Simulate shows it.
key f7
wait 30
annotate @node:UITabContainer The tabs along the top; children laid out below
annotate @hier:UITabContainer/UILabel Children of the tab container
annotate @window:inspector Tab Direction, Active Tab, Tab Size, layout and colours
move 700,88
wait 20
screenshot node_UITabContainerNode
key f7
wait 10
