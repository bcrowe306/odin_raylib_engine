expect node:UIBulletList.type == UIUnorderedListNode
key shift+f
wait 5
annotate @node:UIBulletList The list's area (empty: no items yet)
annotate @window:inspector Selected Index, Default Bullet, Item Height
move 700,88
wait 20
screenshot node_UIUnorderedListNode

# --- Numbered List ---
click @asset.new-scene
click @hier.add
type ui numbered list
click @addnode.create
expect node:UINumberedList.type == UIOrderedListNode
key shift+f
wait 5
annotate @node:UINumberedList The list's area (empty: no items yet)
annotate @window:inspector Numbering, Start Number, Item Height
