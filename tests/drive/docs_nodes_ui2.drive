# Screenshots for the UI nodes' pages, part 2 (docs/nodes/UINotchedSliderNode.md
# ... UITabContainerNode.md, #45): one fresh scene per node.
#   scripts/docs/screenshots.sh docs_nodes_ui2
wait 5

# --- Notched Slider ---
click @asset.new-scene
click @hier.add
type ui notched slider
click @addnode.create
expect node:UINotchedSlider.type == UINotchedSliderNode
dblclick @insp.prop:value
key ctrl+a
type 3
key enter
expect node:UINotchedSlider.prop.value ~= 3
key shift+f
wait 5
annotate @node:UINotchedSlider The slider: five notches, the handle on notch 3
annotate @window:inspector Value, range, notch count, Snap To Notches, orientation
move 700,88
wait 20
screenshot node_UINotchedSliderNode

# --- Volume Fader ---
click @asset.new-scene
click @hier.add
type ui volume fader
click @addnode.create
expect node:UIVolumeFader.type == UIVolumeFaderNode
dblclick @insp.prop:valueDb
key ctrl+a
type -12
key enter
expect node:UIVolumeFader.prop.valueDb ~= -12
key shift+f
wait 5
annotate @node:UIVolumeFader The fader at -12 dB (0 dB is three quarters up)
annotate @window:inspector Value Db, Min Db, Max Db, Default Db
move 700,88
wait 20
screenshot node_UIVolumeFaderNode

# --- Volume Meter (stereo: a right level above -100 dB) ---
click @asset.new-scene
click @hier.add
type ui volume meter
click @addnode.create
expect node:UIVolumeMeter.type == UIVolumeMeterNode
dblclick @insp.prop:levelL
key ctrl+a
type -6
key enter
dblclick @insp.prop:levelR
key ctrl+a
type -18
key enter
expect node:UIVolumeMeter.prop.levelR ~= -18
key shift+f
wait 5
annotate @node:UIVolumeMeter Left at -6 dB, right at -18 dB
annotate @window:inspector Level L / Level R in dB (set them from a script)
move 700,88
wait 20
screenshot node_UIVolumeMeterNode

# --- Separator with a label ---
click @asset.new-scene
click @hier.add
type ui separator
click @addnode.create
expect node:UISeparator.type == UISeparatorNode
click @insp.prop:label
key ctrl+a
type Audio
key enter
expect node:UISeparator.prop.label == Audio
# A label needs about 18 px of height.
dblclick @insp.prop:size.y
key ctrl+a
type 18
key enter
expect node:UISeparator.prop.size ~= 360,18
key shift+f
wait 5
annotate @node:UISeparator The label, then the line
annotate @window:inspector Label and Line Color
move 700,88
wait 20
screenshot node_UISeparatorNode

# --- XY Plot ---
click @asset.new-scene
click @hier.add
type ui xy plot
click @addnode.create
expect node:UIXYPlot.type == UIXYPlotNode
key shift+f
wait 5
annotate @node:UIXYPlot The plot: title, grid, axis ranges
annotate @window:inspector Axis ranges, grid, points, crosshair, colours
move 700,88
wait 20
screenshot node_UIXYPlotNode

# --- List View ---
click @asset.new-scene
click @hier.add
type ui list view
click @addnode.create
expect node:UIListView.type == UIListViewNode
key shift+f
wait 5
annotate @node:UIListView The default items; the first is selected
annotate @window:inspector Selected Index and Item Height
move 700,88
wait 20
screenshot node_UIListViewNode

# --- Tree View (no items yet: the frame) ---
click @asset.new-scene
click @hier.add
type ui tree view
click @addnode.create
expect node:UITreeView.type == UITreeViewNode
