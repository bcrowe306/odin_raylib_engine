# Typed nodes in Lua: the definitions have a class per node type, so a
# camera completes camera methods and a sprite doesn't; Scene.find_node with
# a project node name returns that node's type; a script's self.node has the
# type of the nodes it's attached to (player_ship.lua: a TextureNode).
wait 5
wait-until file:.ore/definitions/project_types.lua contains fun(name: "MainCamera"): CameraNode timeout=600
expect file:.ore/definitions/project_types.lua contains ---@class NodeOf_PlayerShip : TextureNode
expect file:.ore/definitions/project_types.lua contains ---@class PlayerShipNode_ : TextureNode
dblclick @asset:scripts/player_ship.lua
wait-until code.lsp == ready timeout=600
key ctrl+g
type 17
key enter
key enter
key up
type self.node:texture_g
wait-until code.completion contains texture_get_size timeout=600
screenshot self_node_completion
key esc
key enter
type local cam = Scene.find_node("MainCamera")
key enter
type cam:camera_set_z
wait-until code.completion contains camera_set_zoom timeout=600
key esc
key enter
type local ship = Scene.find_node("PlayerShip")
key enter
type ship:c
wait-until code.completion contains connect timeout=600
expect code.completion !contains camera_set_zoom
screenshot sprite_has_no_camera_methods
