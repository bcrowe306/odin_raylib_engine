{
 "name": "Platformer Adventure",
 "version": "0.1.0",
 "initial_scene": "scenes/title.scene.json",
 "window": {
  "title": "Platformer Adventure",
  "width": 1280,
  "height": 720,
  "virtual_width": 320,
  "virtual_height": 180,
  "target_fps": 60
 },
 "video": {
  "fullscreen": false,
  "vsync": true,
  "resizable": true,
  "msaa": false,
  "high_dpi": false,
  "sharp_scaling": true,
  "integer_scaling": true,
  "pixel_snap": true,
  "smooth_camera": true
 },
 "audio": {
  "master_volume": 1,
  "music_volume": 1,
  "sfx_volume": 1
 },
 "physics": {
  "gravity": [
   0,
   900
  ],
  "debug_draw": false
 },
 "input": {
  "actions": [
   {
    "name": "move_left",
    "bindings": [
     {
      "key": "A"
     },
     {
      "key": "LEFT"
     },
     {
      "button": "LEFT_FACE_LEFT"
     },
     {
      "axis": "LEFT_X",
      "positive": false,
      "deadzone": 0.3
     }
    ]
   },
   {
    "name": "move_right",
    "bindings": [
     {
      "key": "D"
     },
     {
      "key": "RIGHT"
     },
     {
      "button": "LEFT_FACE_RIGHT"
     },
     {
      "axis": "LEFT_X",
      "positive": true,
      "deadzone": 0.3
     }
    ]
   },
   {
    "name": "move_up",
    "bindings": [
     {
      "key": "W"
     },
     {
      "key": "UP"
     },
     {
      "button": "LEFT_FACE_UP"
     },
     {
      "axis": "LEFT_Y",
      "positive": false,
      "deadzone": 0.3
     }
    ]
   },
   {
    "name": "move_down",
    "bindings": [
     {
      "key": "S"
     },
     {
      "key": "DOWN"
     },
     {
      "button": "LEFT_FACE_DOWN"
     },
     {
      "axis": "LEFT_Y",
      "positive": true,
      "deadzone": 0.3
     }
    ]
   },
   {
    "name": "jump",
    "bindings": [
     {
      "key": "SPACE"
     },
     {
      "key": "W"
     },
     {
      "key": "UP"
     },
     {
      "button": "RIGHT_FACE_DOWN"
     }
    ]
   },
   {
    "name": "pause",
    "bindings": [
     {
      "key": "ESCAPE"
     },
     {
      "key": "P"
     },
     {
      "button": "MIDDLE_RIGHT"
     }
    ]
   },
   {
    "name": "confirm",
    "bindings": [
     {
      "key": "ENTER"
     },
     {
      "key": "SPACE"
     },
     {
      "button": "RIGHT_FACE_DOWN"
     }
    ]
   }
  ]
 },
 "scenes": [
  "scenes/title.scene.json",
  "scenes/level1.scene.json",
  "scenes/level2.scene.json"
 ]
}
